// Prisma Schema for Ultra Shopping Mall
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication Models
enum UserLocale {
  KO // 한국어 회원 (기본)
  EN // 영어/기타 언어권 회원 (영문 사이트 가입)
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  password      String?    // bcrypt hashed password
  phone         String?
  address       String?    @db.Text
  role          UserRole   @default(USER)
  locale        UserLocale @default(KO) // 가입 언어권
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts             Account[]
  sessions             Session[]
  orders               Order[]
  cart                 Cart?
  reviews              Review[]
  wishlist             Wishlist[]
  loginHistory         LoginHistory[]
  quotesAsCustomer     Quote[]       @relation("CustomerQuotes")
  quotesAsSalesManager Quote[]       @relation("SalesManagerQuotes")

  @@index([email])
  @@index([locale])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  HOSPITAL
  SALES_MANAGER
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Product & Category Models
model Category {
  id          String     @id @default(cuid())
  name        String
  nameEn      String?    // 영문 카테고리명 (영문 사이트용, 없으면 name 사용)
  slug        String     @unique
  description String?    @db.Text
  level       Int        // 1: 대분류, 2: 중분류, 3: 소분류
  sortOrder   Int        @default(0) // 순서 (낮을수록 먼저)
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("SubCategories")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([slug])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id              String   @id @default(cuid())
  name            String
  nameEn          String?  // 영문 상품명 (없으면 name 사용)
  brand           String
  description     String?  @db.Text // 간단한 설명
  descriptionEn   String?  @db.Text // 영문 설명
  detailContent   String?  @db.Text // 상세 내용 (HTML)
  detailContentEn String?  @db.Text // 영문 상세 내용 (HTML)
  moq             String?  // 최소 주문 수량 표기 (예: "100 Vials")
  isFeaturedEn    Boolean  @default(false) // 영문 메인 Featured Products 노출
  price           Int      // 원화 단위 (원)
  discount      Int      @default(0) // 할인율 (%)
  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    String
  imageUrl      String?  // 메인 이미지 (nullable로 변경)
  images        String[] // 추가 이미지 URLs (최대 5장)
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  isNew         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlist   Wishlist[]
  quoteItems QuoteItem[]

  @@index([categoryId])
  @@index([brand])
  @@index([isActive])
  @@index([isNew])
  @@index([isFeaturedEn])
  @@map("products")
}

// Cart Models
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// Order Models
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Int         // 총 결제 금액 (원)
  items         OrderItem[]
  shippingAddr  String      @db.Text
  recipientName String
  recipientPhone String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  PENDING   // 결제 대기
  PAID      // 결제 완료
  PREPARING // 배송 준비
  SHIPPED   // 배송중
  DELIVERED // 배송 완료
  CANCELLED // 취소
  REFUNDED  // 환불
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int      // 주문 당시 가격 (할인 적용 후)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Review Model
model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int          // 1-5
  comment   String?      @db.Text
  images    String[]     // 리뷰 이미지 URLs
  status    ReviewStatus @default(PENDING) // 승인 상태
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([rating])
  @@index([status])
  @@map("reviews")
}

enum ReviewStatus {
  PENDING  // 승인 대기
  APPROVED // 승인됨 (노출)
  REJECTED // 거부됨 (숨김)
}

// Contact Model
model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  type      ContactType
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@map("contacts")
}

enum ContactType {
  PRODUCT  // 상품 문의
  SHIPPING // 배송 문의
  RETURN   // 반품/교환
  OTHER    // 기타
}

enum ContactStatus {
  PENDING     // 대기중
  IN_PROGRESS // 처리중
  RESOLVED    // 해결됨
}

// Wishlist Model
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

// Login History Model
model LoginHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String
  userAgent   String   @db.Text
  device      String?  // 디바이스 종류 (Mobile, Desktop, Tablet)
  browser     String?  // 브라우저 정보
  os          String?  // 운영체제 정보
  country     String?  // 국가
  city        String?  // 도시
  success     Boolean  @default(true) // 로그인 성공 여부
  failReason  String?  // 실패 이유 (있는 경우)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_histories")
}

// Quote (견적서) Models
model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String      @unique // QT-20250108-0001
  customerId      String      // 고객 (병원/일반회원)
  customer        User        @relation("CustomerQuotes", fields: [customerId], references: [id], onDelete: Cascade)
  salesManagerId  String      // 영업매니저
  salesManager    User        @relation("SalesManagerQuotes", fields: [salesManagerId], references: [id], onDelete: Cascade)
  status          QuoteStatus @default(PENDING)
  totalAmount     Int         // 견적 총액 (조정된 가격)
  originalAmount  Int         // 원래 총액
  discountAmount  Int         @default(0) // 할인액
  items           QuoteItem[]
  validUntil      DateTime    // 견적 유효기간
  notes           String?     @db.Text // 영업매니저 메모
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([salesManagerId])
  @@index([status])
  @@index([quoteNumber])
  @@map("quotes")
}

enum QuoteStatus {
  PENDING  // 견적 작성 대기
  SENT     // 고객에게 전송됨
  APPROVED // 고객 승인 (결제 가능)
  REJECTED // 고객 거부
  EXPIRED  // 기간 만료
  ORDERED  // 주문 완료
}

// 견적서 항목
model QuoteItem {
  id            String   @id @default(cuid())
  quoteId       String
  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int      // 수량
  originalPrice Int      // 원래 단가 (할인 적용 전)
  quotedPrice   Int      // 견적 단가 (영업매니저가 조정)
  createdAt     DateTime @default(now())

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

// Carousel (메인페이지 캐러셀) Model
model Carousel {
  id          String   @id @default(cuid())
  title       String   // 캐러셀 제목
  subtitle    String?  // 부제목
  description String?  @db.Text // 설명
  imageUrl    String   // 이미지 URL
  linkUrl     String?  // 클릭시 이동할 URL
  linkText    String?  // 링크 버튼 텍스트 (예: "자세히 보기")
  order       Int      @default(0) // 순서 (낮을수록 먼저 표시)
  isActive    Boolean  @default(true) // 활성화 여부
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("carousels")
}

model LayerPopup {
  id          String    @id @default(cuid())
  title       String                          // 관리용 제목 (관리자 화면용)
  contentType String    @default("image")     // "image" | "html"
  imageUrl    String    @default("")          // 팝업 이미지 (Base64)
  content     String?   @db.Text              // HTML 팝업용 콘텐츠
  linkUrl     String?                         // 이미지 클릭 시 이동 URL
  startDate   DateTime?                       // 노출 시작일 (null=즉시)
  endDate     DateTime?                       // 노출 종료일 (null=무기한)
  order       Int       @default(0)           // 표시 순서 (낮을수록 먼저)
  isActive    Boolean   @default(true)        // 활성화 여부
  width       Int       @default(480)         // 팝업 너비(px)
  height      Int       @default(600)         // 팝업 높이(px)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("layer_popups")
}

// Notice (공지사항) Models
enum NoticeCategory {
  GENERAL    // 일반
  EVENT      // 이벤트
  UPDATE     // 업데이트
  IMPORTANT  // 중요
}

enum NoticeLocale {
  KO // 한국어 사이트 공지
  EN // 영문 사이트 공지
}

model Notice {
  id        String         @id @default(cuid())
  title     String
  content   String         @db.Text
  category  NoticeCategory @default(GENERAL)
  locale    NoticeLocale   @default(KO)
  isPinned  Boolean        @default(false)
  isActive  Boolean        @default(true)
  viewCount Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([category])
  @@index([locale, isActive, createdAt]) // 공지 목록 조회 커버링 (locale+isActive 필터 + createdAt 정렬)
  @@index([isActive, createdAt])
  @@map("notices")
}

// Inquiry (영문 사이트 B2B 문의) Models
enum InquiryType {
  PRODUCT_QUOTATION // 제품 견적 요청
  OEM_ODM           // OEM / ODM 문의
  DISTRIBUTOR       // 총판/파트너십 문의
  TECHNICAL         // 기술 지원
  GENERAL           // 일반 문의
}

enum InquiryStatus {
  PENDING     // 대기중
  IN_PROGRESS // 처리중
  RESOLVED    // 해결됨
}

model Inquiry {
  id                 String        @id @default(cuid())
  type               InquiryType   @default(PRODUCT_QUOTATION)
  companyName        String
  country            String
  website            String?
  contactPerson      String?
  email              String
  phone              String?
  orderQuantity      String?       // 예상 주문 수량
  orderTimeline      String?       // 예상 주문 시기
  targetMarket       String?       // 목표 시장
  interestedProducts String[]      // 관심 제품 (이름/카테고리 목록)
  message            String        @db.Text
  status             InquiryStatus @default(PENDING)
  adminNotes         String?       @db.Text // 관리자 메모
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("inquiries")
}
